{
  "buildCommand": "cd ieb-luz-malaga && npm install && npm run build",
  "outputDirectory": "ieb-luz-malaga/.next",
  "framework": "nextjs",
  "installCommand": "cd ieb-luz-malaga && npm install",
  "devCommand": "cd ieb-luz-malaga && npm run dev",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
