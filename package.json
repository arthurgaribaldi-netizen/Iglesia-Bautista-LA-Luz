{
  "name": "ieb-luz-malaga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "cross-env SKIP_DATABASE_CHECK=true prisma generate --schema=ieb-luz-malaga/prisma/schema.prisma && next build",
    "build:clean": "rm -rf .next && npm run build",
    "build:force": "npm run fix:minification",
    "fix:minification": "node scripts/fix-build-minification.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "quality": "npm run lint && npm run type-check && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "test": "jest --passWithNoTests --maxWorkers=75%",
    "test:watch": "jest --watch --passWithNoTests --maxWorkers=50%",
    "test:coverage": "jest --coverage --passWithNoTests --maxWorkers=50%",
    "test:ci": "jest --ci --coverage --watchAll=false --maxWorkers=50% --workerIdleMemoryLimit=256MB --passWithNoTests",
    "test:fast": "jest --maxWorkers=75% --testTimeout=15000 --passWithNoTests --silent",
    "test:debug": "jest --detectOpenHandles --forceExit --verbose --passWithNoTests --maxWorkers=25%",
    "test:changed": "jest --onlyChanged --passWithNoTests --maxWorkers=50%",
    "test:pattern": "jest --testPathPattern",
    "test:async": "jest --config=jest.async.config.js --passWithNoTests --maxWorkers=50%",
    "test:async:watch": "jest --config=jest.async.config.js --watch --passWithNoTests --maxWorkers=25%",
    "test:async:ci": "jest --config=jest.async.config.js --ci --coverage --watchAll=false --maxWorkers=25% --workerIdleMemoryLimit=512MB --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:ci && npm run test:e2e",
    "db:generate": "prisma generate --schema=ieb-luz-malaga/prisma/schema.prisma",
    "db:push": "prisma db push --schema=ieb-luz-malaga/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=ieb-luz-malaga/prisma/schema.prisma",
    "db:seed": "tsx scripts/migrate-church-data.ts",
    "db:reset": "prisma migrate reset --force --schema=ieb-luz-malaga/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=ieb-luz-malaga/prisma/schema.prisma",
    "security": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "deps": "npm update && npm outdated",
    "deps:update": "npm update",
    "deps:outdated": "npm outdated",
    "deps:strategy": "node scripts/dependency-update-strategy.js",
    "deps:safe": "npm update @sentry/nextjs @supabase/supabase-js framer-motion @playwright/test tsx",
    "cache": "node scripts/jest-cache-manager.js",
    "cache:clean": "node scripts/jest-cache-manager.js clean",
    "cache:optimize": "node scripts/jest-cache-manager.js optimize",
    "strategy": "node scripts/test-strategy.js",
    "check:env": "node scripts/check-env.js",
    "check:production": "node scripts/check-production.js",
    "setup:ci-cd": "node scripts/setup-ci-cd.js",
    "optimize": "node scripts/test-optimizations.js",
    "verify:console-cleanup": "node scripts/verify-console-cleanup.js",
    "build:verify": "npm run build && npm run verify:console-cleanup",
    "prebuild": "prisma generate --schema=ieb-luz-malaga/prisma/schema.prisma",
    "postbuild": "node scripts/test-fallbacks.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.7.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@sentry/nextjs": "^10.15.0",
    "@sentry/replay": "^7.116.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@vercel/analytics": "^1.5.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^12.23.22",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.303.0",
    "next": "^14.2.32",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-security": "^1.7.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "postcss": "^8",
    "prettier": "^3.0.0",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
