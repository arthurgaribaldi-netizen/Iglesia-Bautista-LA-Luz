# Configuração de Variáveis de Ambiente - IEB La Luz Málaga
# Copie este arquivo para .env.local e configure as variáveis

# ============================================================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ============================================================================

# URL do banco de dados PostgreSQL (Supabase)
DATABASE_URL="postgresql://username:password@host:port/database"

# URL de conexão direta do Supabase (se usando Supabase)
DIRECT_URL="postgresql://username:password@host:port/database"

# ============================================================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO
# ============================================================================

# Chave secreta para JWT (gere uma chave forte e única)
JWT_SECRET="sua-chave-secreta-muito-forte-aqui-minimo-32-caracteres"

# Tempo de expiração do token JWT (em segundos)
JWT_EXPIRES_IN="86400" # 24 horas

# ============================================================================
# CONFIGURAÇÕES DO SUPABASE (se usando)
# ============================================================================

# Chaves do Supabase
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anonima-do-supabase"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-de-servico-do-supabase"

# ============================================================================
# CONFIGURAÇÕES DO NEXT.JS
# ============================================================================

# Ambiente de execução
NODE_ENV="development" # ou "production"

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# CONFIGURAÇÕES DE UPLOAD E ARMAZENAMENTO
# ============================================================================

# Configurações de upload (se usando Supabase Storage)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="uploads"

# Tamanho máximo de arquivo (em bytes)
MAX_FILE_SIZE="10485760" # 10MB

# Tipos de arquivo permitidos
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ============================================================================
# CONFIGURAÇÕES DE EMAIL (opcional)
# ============================================================================

# Configurações SMTP para envio de emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"

# Email de contato da igreja
CHURCH_EMAIL="contato@igrejabautistalaluz.com"

# ============================================================================
# CONFIGURAÇÕES DE ANALYTICS (opcional)
# ============================================================================

# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="seu-id-do-vercel"

# ============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO (opcional)
# ============================================================================

# Sentry para monitoramento de erros
SENTRY_DSN="https://sua-dsn-do-sentry@sentry.io/projeto"
SENTRY_ORG="sua-organizacao"
SENTRY_PROJECT="seu-projeto"

# ============================================================================
# CONFIGURAÇÕES DE API EXTERNAS (opcional)
# ============================================================================

# YouTube API (para integração com canal)
YOUTUBE_API_KEY="sua-chave-da-api-do-youtube"
YOUTUBE_CHANNEL_ID="ID-do-canal-do-youtube"

# Google Maps API (para localização da igreja)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="sua-chave-da-api-do-google-maps"

# ============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# ============================================================================

# Rate limiting (requisições por minuto)
RATE_LIMIT_MAX="100"

# CORS origins permitidas (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,https://seu-dominio.com"

# ============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ============================================================================

# Pular verificação de banco durante build
SKIP_DATABASE_CHECK="true"

# Habilitar logs detalhados
DEBUG="true"

# ============================================================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# ============================================================================

# 1. Copie este arquivo para .env.local
# 2. Configure as variáveis necessárias
# 3. Para produção, use variáveis de ambiente seguras
# 4. Nunca commite arquivos .env com dados reais
# 5. Use .env.example para documentar variáveis necessárias
